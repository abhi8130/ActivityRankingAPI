{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ambiguousLocationResponse.schema.json",
  "title": "Activity Rankings - 422 AMBIGUOUS_LOCATION response",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "message", "matches"],
  "properties": {
    "error": { "const": "AMBIGUOUS_LOCATION" },
    "message": { "type": "string", "minLength": 1 },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["locationId", "city", "country"],
        "properties": {
          "locationId": { "type": "string", "minLength": 1 },
          "city": { "type": "string", "minLength": 1 },
          "region": { "type": "string" },
          "country": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
