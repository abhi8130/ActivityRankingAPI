{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rankingSuccessResponse.schema.json",
  "title": "Activity Rankings - 200 OK response",
  "type": "object",
  "additionalProperties": false,
  "required": ["city", "town", "generatedAt", "totalDays", "days"],
  "properties": {
    "city": { "type": "string", "minLength": 1 },
    "town": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "totalDays": { "type": "integer", "minimum": 1 },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "rankings"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "rankings": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "activityId", "name", "score", "reasoning"],
              "properties": {
                "rank": { "type": "integer", "minimum": 1 },
                "activityId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "score": { "type": "number", "minimum": 0 },
                "reasoning": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
